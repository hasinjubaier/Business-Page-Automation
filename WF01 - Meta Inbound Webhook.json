    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO webhook_events (platform, external_event_id, event_type, payload_hash, processing_status)\n  VALUES ($1, $2, $3, $4, 'received')\n  ON CONFLICT (platform, external_event_id) DO NOTHING\n  RETURNING id\n)\nSELECT ins.id AS webhook_event_id,\n  (SELECT c.order_state\n     FROM conversations c\n     JOIN customers cu ON cu.customer_id = c.customer_id\n    WHERE cu.platform = $1 AND cu.platform_user_id = $5\n    ORDER BY c.last_message_at DESC NULLS LAST\n    LIMIT 1) AS order_state\nFROM ins;",
        "options": {
          "queryReplacement": "={{ [$json.platform, $json.external_event_id, $json.event_type, $json.payload_hash, $json.sender_id] }}"
        }
      },
