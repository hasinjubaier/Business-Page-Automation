    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst ev = $('Hash Event Payload').item.json;\nconst text = String(ev.message_text || ev.postback_payload || '');\nconst orderRegex = /(\\border\\b|\\bbuy\\b|\\bpurchase\\b|অর্ডার|কিনব|কিনতে|নিতে চাই|নিব)/i;\nconst activeStates = ['draft', 'awaiting_confirmation'];\nconst state = $json.order_state || 'none';\nlet route = 'WF02';\nif (ev.event_type === 'comment') {\n  route = 'WF05';\n} else if (activeStates.includes(state) || orderRegex.test(text)) {\n  route = 'WF03';\n}\nreturn { json: Object.assign({}, ev, { webhook_event_id: $json.webhook_event_id, order_state: state, route: route }) };\n"
      },
