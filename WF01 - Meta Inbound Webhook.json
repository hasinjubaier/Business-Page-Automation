    {
      "parameters": {
        "jsCode": "\nconst payload = $input.first().json.payload;\nconst platform = payload.object === 'instagram' ? 'instagram' : 'facebook';\nconst out = [];\nfor (const entry of (payload.entry || [])) {\n  const pageId = String(entry.id || '');\n  for (const m of (entry.messaging || [])) {\n    const senderId = String((m.sender && m.sender.id) || '');\n    const recipientId = String((m.recipient && m.recipient.id) || '');\n    const eventTime = m.timestamp || entry.time || null;\n    const base = { platform: platform, page_id: pageId, sender_id: senderId, recipient_id: recipientId, event_time: eventTime };\n    if (!senderId || senderId === pageId) continue;\n    if (m.message) {\n      if (m.message.is_echo || !m.message.mid) continue;\n      const atts = (m.message.attachments || []).map(function (a) {\n        return { type: a.type || null, url: (a.payload && a.payload.url) || null };\n      });\n      const text = m.message.text || '';\n      if (!text && atts.length === 0) continue;\n      out.push({ json: Object.assign({}, base, {\n        external_event_id: String(m.message.mid),\n        event_type: (!text && atts.length > 0) ? 'attachment' : 'text_message',\n        message_text: text,\n        attachments: atts,\n        platform_message_id: String(m.message.mid)\n      }) });\n    } else if (m.postback) {\n      const pb = m.postback.payload || m.postback.title || '';\n      const pbId = m.postback.mid ? String(m.postback.mid) : ('pb:' + senderId + ':' + eventTime + ':' + pb);\n      out.push({ json: Object.assign({}, base, {\n        external_event_id: pbId,\n        event_type: 'postback',\n        message_text: String(pb),\n        postback_payload: String(m.postback.payload || ''),\n        attachments: [],\n        platform_message_id: m.postback.mid ? String(m.postback.mid) : null\n      }) });\n    }\n  }\n  for (const ch of (entry.changes || [])) {\n    const v = ch.value || {};\n    if (platform === 'facebook' && ch.field === 'feed' && v.item === 'comment' && v.verb === 'add') {\n      const fromId = String((v.from && v.from.id) || '');\n      if (!v.comment_id || !fromId || fromId === pageId) continue;\n      out.push({ json: {\n        platform: 'facebook', page_id: pageId, sender_id: fromId, recipient_id: pageId,\n        event_time: v.created_time || entry.time || null,\n        external_event_id: 'comment:' + v.comment_id,\n        event_type: 'comment',\n        message_text: v.message || '',\n        attachments: [],\n        comment_id: String(v.comment_id),\n        post_id: v.post_id ? String(v.post_id) : null,\n        parent_id: v.parent_id ? String(v.parent_id) : null,\n        sender_name: (v.from && v.from.name) || null\n      } });\n    } else if (platform === 'instagram' && ch.field === 'comments') {\n      const fromId = String((v.from && v.from.id) || '');\n      if (!v.id || !fromId || fromId === pageId) continue;\n      out.push({ json: {\n        platform: 'instagram', page_id: pageId, sender_id: fromId, recipient_id: pageId,\n        event_time: entry.time || null,\n        external_event_id: 'comment:' + v.id,\n        event_type: 'comment',\n        message_text: v.text || '',\n        attachments: [],\n        comment_id: String(v.id),\n        post_id: (v.media && v.media.id) ? String(v.media.id) : null,\n        parent_id: v.parent_id ? String(v.parent_id) : null,\n        sender_name: (v.from && v.from.username) || null\n      } });\n    }\n  }\n}\nreturn out;\n"
      },
