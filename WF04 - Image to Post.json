        "query": "SELECT COALESCE(json_agg(json_build_object(\n  'product_id', product_id, 'sku', sku, 'name', product_name, 'category', category,\n  'scent_notes', scent_notes, 'size_ml', size_ml, 'price_bdt', price_bdt, 'stock', stock_quantity\n)), '[]'::json) AS products\nFROM products WHERE active = TRUE",
        "options": {}
