    {
      "parameters": {
        "jsCode": "const ai = $input.first().json.output || {};\nconst products = $('Load Product Catalog').first().json.products || [];\nconst file = $('New Image in Drive Folder').first().json;\n\nlet product = null;\nif (ai.product_id && Number(ai.match_confidence) >= 0.7) {\n  product = products.find(p => Number(p.product_id) === Number(ai.product_id)) || null;\n}\n\nconst BAD = /[0-9\\u09E6-\\u09EF]|৳|tk\\b|taka|টাকা|bdt|discount|ছাড়|অফার|offer/i;\nfunction clean(text, fallback) {\n  const t = String(text || '').trim();\n  return t && !BAD.test(t) ? t : fallback;\n}\n\nconst baseName = product ? product.name : '';\nconst fbFallback = baseName ? baseName + ' এখন Anfas-এ।' : 'নতুন কালেকশন এখন Anfas-এ।';\nconst igFallback = baseName ? baseName + ' — Anfas' : 'Anfas-এর নতুন কালেকশন';\n\nlet fbCaption = clean(ai.facebook_caption, fbFallback);\nlet igCaption = clean(ai.instagram_caption, igFallback);\n\n// Price comes from the database, never from the AI\nif (product && Number(product.stock) > 0) {\n  const price = 'দাম: ' + Number(product.price_bdt) + ' টাকা';\n  fbCaption += '\\n' + price;\n  igCaption += '\\n' + price;\n}\n\nconst tags = (Array.isArray(ai.hashtags) ? ai.hashtags : [])\n  .map(h => String(h).trim().replace(/\\s+/g, ''))\n  .filter(h => /^#[^#]{2,40}$/.test(h))\n  .slice(0, 8);\nif (!tags.includes('#Anfas')) tags.unshift('#Anfas');\nconst hashtags = tags.join(' ');\n\nconst base = {\n  source_file_id: file.id,\n  file_hash: file.md5Checksum || '',\n  product_id: product ? String(product.product_id) : '',\n  hashtags,\n  product_name: baseName || 'Unmatched product',\n  file_name: file.name || ''\n};\nreturn [\n  { json: { ...base, channel: 'facebook', caption: fbCaption } },\n  { json: { ...base, channel: 'instagram', caption: igCaption } }\n];"
      },
