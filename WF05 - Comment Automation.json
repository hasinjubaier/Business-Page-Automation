    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "price_inquiry",
                "product_question",
                "order_interest",
                "praise",
                "complaint",
                "spam",
                "abusive",
                "other"
              ]
            },
            "product_query": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            }
          },
          "required": [
            "category",
            "product_query",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "id": "2cf14e1e-e36b-434e-8214-063b291c007c",
      "name": "Comment Output Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        640,
        352
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(t), '[]'::json) AS matches FROM (\n  SELECT product_id, product_name, price_bdt, stock_quantity\n  FROM products\n  WHERE active = TRUE AND NULLIF($1, '') IS NOT NULL\n    AND (lower(product_name) LIKE '%' || lower($1) || '%' OR lower(sku) = lower($1))\n  ORDER BY product_name LIMIT 3\n) t",
        "options": {
          "queryReplacement": "={{ [String($json.output.product_query || \"\").slice(0, 80)] }}"
        }
      },
      "id": "aad8248c-934d-4eb7-bcc0-9a96fba65ecd",
      "name": "Retrieve Verified Product",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        848,
        128
      ],
      "credentials": {
        "postgres": {
          "id": "mUyNiJpJoy8nDP5U",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $('Workflow Input (from WF01)').item.json;\nconst cls = $('Classify Comment').item.json.output || {};\nconst matches = ($json.matches || []);\nconst text = String(input.message_text || '').trim();\nconst category = cls.category || 'other';\nconst confidence = Number(cls.confidence || 0);\n\nconst hasLink = /https?:\\/\\/|www\\.|\\bt\\.me\\/|wa\\.me\\//i.test(text);\nlet action = 'ignore';\nlet publicText = '';\nlet privateText = '';\nlet reason = category;\n\nif (!text) {\n  action = 'ignore'; reason = 'empty comment';\n} else if (hasLink || category === 'spam' || category === 'abusive') {\n  action = 'hide'; reason = hasLink ? 'contains link' : category;\n} else if (category === 'complaint') {\n  action = 'escalate';\n} else if (confidence < 0.6) {\n  action = 'ignore'; reason = 'low confidence';\n} else if (category === 'praise') {\n  action = 'reply';\n  publicText = 'ধন্যবাদ! Anfas-এর পাশে থাকার জন্য কৃতজ্ঞ।';\n} else if (['price_inquiry', 'product_question', 'order_interest'].includes(category)) {\n  action = 'reply';\n  publicText = 'ধন্যবাদ! বিস্তারিত তথ্য আমরা আপনাকে ইনবক্সে পাঠিয়েছি।';\n  const p = matches.length === 1 ? matches[0] : null;\n  if (p && Number(p.stock_quantity) > 0 && (category === 'price_inquiry' || category === 'order_interest')) {\n    privateText = p.product_name + '-এর দাম ' + Number(p.price_bdt) + ' টাকা। অর্ডার করতে চাইলে এই চ্যাটে আপনার নাম, ফোন নম্বর ও ঠিকানা জানান।';\n  } else {\n    privateText = 'আপনার প্রশ্নের জন্য ধন্যবাদ। কোন পণ্যটি জানতে চান তা এই চ্যাটে লিখে জানালে আমরা সাহায্য করব।';\n  }\n}\n\nconst statusMap = { reply: 'processing', hide: 'processing', escalate: 'escalated', ignore: 'ignored' };\nreturn { json: {\n  action,\n  reason,\n  category,\n  platform: input.platform,\n  comment_id: input.comment_id,\n  sender_id: input.sender_id,\n  sender_name: input.sender_name || '',\n  post_id: input.post_id || '',\n  comment_excerpt: text.slice(0, 200),\n  public_text: publicText,\n  private_text: privateText,\n  claim_status: statusMap[action],\n  claim_key: 'comment:' + input.comment_id\n} };"
      },
      "id": "e5a3f58f-9eed-48c1-8c0e-9a9480f3a92f",
      "name": "Decide Comment Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
